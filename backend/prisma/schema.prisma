// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * User
 */

enum UserRole {
  ADMIN
  CUSTOMER
}

model User {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  email            String             @unique
  passwordHash     String
  role             UserRole           @default(CUSTOMER)
  favoriteProducts FavoriteProducts[]
  orders Order[]
}

/* Products */

model Brand {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

enum ProductKind {
  GUITAR
  BASS
  PEDAL
  AMPLIFIER
  MICROPHONE
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      
  description String
  weight      Decimal     @db.Decimal(5, 2)
  kind        ProductKind
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  brand       Brand       @relation(fields: [brandId], references: [id])
  brandId     Int
  model       String
  imageUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guitarSpecs      GuitarSpecs?
  bassSpecs        BassSpecs?
  amplifierSpecs   AmplifierSpecs?
  pedalSpecs       PedalSpecs?
  microphoneSpecs  MicrophoneSpecs?
  favoriteProducts FavoriteProducts[]
  orderItems OrderItem[]
}

model GuitarSpecs {
  productId            String   @id @db.Uuid
  stringCount          Int
  bodyMaterial         String?
  neckMaterial         String?
  fretboardMaterial    String?
  pickupConfiguration  String?
  pickupType           String?
  bridgeType           String?
  scaleLength          Float?
  fretCount            Int?
  orientation          String?
  hasActiveElectronics Boolean?
  finish               String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model BassSpecs {
  productId            String   @id @db.Uuid
  stringCount          Int
  bodyMaterial         String?
  neckMaterial         String?
  fretboardMaterial    String?
  pickupConfiguration  String?
  pickupType           String?
  bridgeType           String?
  scaleLength          Float?
  fretCount            Int?
  orientation          String?
  hasActiveElectronics Boolean?
  finish               String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model AmplifierSpecs {
  productId          String   @id @db.Uuid
  powerWatts         Int
  amplifierType      String
  instrumentType     String
  speakerSize        Float?
  speakerCount       Int?
  impedanceOhms      Float?
  channelCount       Int?
  hasEffects         Boolean?
  hasReverb          Boolean?
  hasHeadphoneOutput Boolean?
  hasEffectsLoop     Boolean?
  connectivity       String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PedalSpecs {
  productId       String   @id @db.Uuid
  effectType      String
  instrumentType  String
  bypassType      String?
  powerSupply     String?
  voltage         Int?
  currentDrawMa   Int?
  inputCount      Int?
  outputCount     Int?
  stereo          Boolean?
  analogOrDigital String?
  hasMidi         Boolean?
  hasUsb          Boolean?
  batteryPowered  Boolean?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MicrophoneSpecs {
  productId            String   @id @db.Uuid
  microphoneType       String
  polarPattern         String
  frequencyResponseMin Int?
  frequencyResponseMax Int?
  sensitivity          Float?
  impedanceOhms        Int?
  connectionType       String
  requiresPhantomPower Boolean?
  maxSplDb             Float?
  wireless             Boolean

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/* Favorite Product */

model FavoriteProducts {
  id        Int    @id @default(autoincrement())
  productId String @db.Uuid
  userId    String @db.Uuid

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
}

/* Order */

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id  String  @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  orderStatus OrderStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt
  deliveredAt DateTime?
  
  items OrderItem[]

  user User @relation(fields: [userId], references: [id])
}

model OrderItem {
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
}
